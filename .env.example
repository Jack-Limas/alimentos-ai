# Runtime environment: development | test | production
NODE_ENV=
# HTTP port (optional, defaults to 4100; Render injects it)
PORT=
# Shared secret with alimentos-backend sent as X-Internal-Key (min 32 chars)
AI_INTERNAL_KEY=
# Gemini API key, known only by this service. Without it the AI endpoints answer INVALID_API_KEY
GEMINI_API_KEY=
# Gemini model id (a flash model), checked against the models the key can use
GEMINI_MODEL=
# Optional: total timeout per AI call in ms, retry included (default 12000, max 14000)
AI_UPSTREAM_TIMEOUT_MS=
# npm run smoke:prod only (never on Render): URL of the deployed service
AI_SMOKE_URL=
