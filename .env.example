# Runtime environment: development | test | production
NODE_ENV=
# HTTP port (optional, defaults to 4100; Render injects it)
PORT=
# Shared secret with alimentos-backend sent as X-Internal-Key (min 32 chars)
AI_INTERNAL_KEY=
# Gemini API key, known only by this service (phase 3)
GEMINI_API_KEY=
# Gemini model id to use (phase 3)
GEMINI_MODEL=
# Timeout in milliseconds for calls to Gemini (phase 3)
AI_UPSTREAM_TIMEOUT_MS=
