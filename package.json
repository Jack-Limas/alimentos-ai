{
  "name": "alimentos-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AlimentaIQ AI microservice: internal Gemini gateway called only by alimentos-backend",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:gemini": "tsx scripts/smoke-gemini.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/sensible": "6.0.7",
    "@google/genai": "2.31.0",
    "dotenv": "18.0.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
